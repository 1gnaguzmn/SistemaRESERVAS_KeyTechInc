# Desarrollo local. Copiar a .env y completar con credenciales propias.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reservas
DB_USER=reservas_app
DB_PASSWORD=
# Generar una clave propia de al menos 32 caracteres; obligatoria en producción.
SESSION_SECRET=
APP_ORIGINS=http://localhost:5173,http://localhost:3000
# Activar solo detrás de un único proxy confiable que termina TLS.
TRUST_PROXY=0
